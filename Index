<script>
// ── Data ──
const CATS = {
  'Housing & Utilities':   { color: '#c8f066', icon: '🏠' },
  'Food & Groceries':      { color: '#f0c866', icon: '🛒' },
  'Transport':             { color: '#66c8f0', icon: '🚗' },
  'Entertainment':         { color: '#f066a8', icon: '🎬' },
  'Savings & Investments': { color: '#a066f0', icon: '💰' },
};
const MONTHS = ['January','February','March','April','May','June','July','August','September','October','November','December'];

let transactions = JSON.parse(localStorage.getItem('budget_tx') || '[]');
let goals = JSON.parse(localStorage.getItem('budget_goals') || '[]');
let txType = 'expense';
let currentPage = 'home';

const now = new Date();
let currentMonth = now.getMonth();
let currentYear = now.getFullYear();

function save() {
  localStorage.setItem('budget_tx', JSON.stringify(transactions));
  localStorage.setItem('budget_goals', JSON.stringify(goals));
}

// ── Navigation ──
function goPage(p) {
  document.querySelectorAll('.page').forEach(el => el.classList.remove('active'));
  document.querySelectorAll('.nav-btn').forEach(el => el.classList.remove('active'));
  document.getElementById('page-' + p).classList.add('active');
  document.getElementById('nav-' + p).classList.add('active');
  currentPage = p;
  // Show FAB only on tx page or home
  document.getElementById('fab').style.display = p === 'goals' ? 'none' : 'flex';
  render();
}

function changeMonth(d) {
  currentMonth += d;
  if (currentMonth > 11) { currentMonth = 0; currentYear++; }
  if (currentMonth < 0)  { currentMonth = 11; currentYear--; }
  render();
}

// ── Render ──
function getMonthTx() {
  return transactions.filter(t => {
    const d = new Date(t.date + 'T12:00:00');
    return d.getMonth() === currentMonth && d.getFullYear() === currentYear;
  });
}

function fmt(n) {
  return '$' + Math.abs(n).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
}

function fmtDate(d) {
  return new Date(d + 'T12:00:00').toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
}

function esc(s) {
  return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
}

function render() {
  document.getElementById('monthLabel').textContent = MONTHS[currentMonth].slice(0,3) + ' ' + currentYear;

  const txs = getMonthTx();
  const income   = txs.filter(t => t.type === 'income').reduce((s,t) => s + t.amount, 0);
  const expenses = txs.filter(t => t.type === 'expense').reduce((s,t) => s + t.amount, 0);
  const balance  = income - expenses;

  // Summary
  document.getElementById('incomeAmt').textContent   = fmt(income);
  document.getElementById('expensesAmt').textContent = fmt(expenses);
  document.getElementById('balanceAmt').textContent  = (balance < 0 ? '-' : '') + fmt(balance);
  document.getElementById('incomeCount').textContent  = txs.filter(t=>t.type==='income').length + ' entries';
  document.getElementById('expenseCount').textContent = txs.filter(t=>t.type==='expense').length + ' entries';
  document.getElementById('balanceSub').textContent   = balance >= 0 ? '✓ You\'re on track' : '⚠ Spending exceeds income';

  // Categories
  const catTotals = {};
  Object.keys(CATS).forEach(c => catTotals[c] = 0);
  txs.filter(t => t.type === 'expense').forEach(t => { if (catTotals[t.category] !== undefined) catTotals[t.category] += t.amount; });
  const maxCat = Math.max(...Object.values(catTotals), 1);

  document.getElementById('catList').innerHTML = Object.entries(catTotals).map(([cat, amt]) => `
    <div class="cat-row">
      <div class="cat-dot" style="background:${CATS[cat].color}"></div>
      <div class="cat-name">${cat}</div>
      <div class="cat-bar-wrap"><div class="cat-bar-fill" style="background:${CATS[cat].color};width:${amt/maxCat*100}%"></div></div>
      <div class="cat-amount">${fmt(amt)}</div>
    </div>
  `).join('');

  // Transaction list
  const sorted = [...txs].sort((a,b) => new Date(b.date) - new Date(a.date));
  const allSorted = [...transactions].sort((a,b) => new Date(b.date) - new Date(a.date));

  const renderTxs = (list, el) => {
    if (list.length === 0) {
      el.innerHTML = '<div class="empty-state">No transactions yet.<br>Tap <strong>+</strong> to add one!</div>';
    } else {
      el.innerHTML = list.map(t => {
        const cat = CATS[t.category] || { color:'#888', icon:'💸' };
        const isExp = t.type === 'expense';
        return `
          <div class="tx-item">
            <div class="tx-icon" style="background:${cat.color}22">${cat.icon}</div>
            <div class="tx-info">
              <div class="tx-desc">${esc(t.desc)}</div>
              <div class="tx-meta">${esc(t.category)} · ${fmtDate(t.date)}</div>
            </div>
            <div class="tx-right">
              <div class="tx-amount" style="color:${isExp ? 'var(--accent3)' : 'var(--income-color)'}">${isExp ? '-' : '+'}${fmt(t.amount)}</div>
              <button class="tx-del" onclick="delTx('${t.id}')">✕</button>
            </div>
          </div>
        `;
      }).join('');
    }
  };

  renderTxs(sorted, document.getElementById('txList'));

  // Goals
  const goalsList = document.getElementById('goalsList');
  if (goals.length === 0) {
    goalsList.innerHTML = '<div class="empty-state">No goals yet.<br>Add one to start saving!</div>';
  } else {
    goalsList.innerHTML = goals.map(g => {
      const pct = Math.min(100, Math.round(g.current / g.target * 100));
      return `
        <div class="goal-card">
          <div class="goal-header">
            <div class="goal-name">${esc(g.name)}</div>
            <button class="goal-del" onclick="delGoal('${g.id}')">✕</button>
          </div>
          <div class="goal-amounts">${fmt(g.current)} saved of ${fmt(g.target)}</div>
          <div class="goal-bar"><div class="goal-bar-fill" style="width:${pct}%"></div></div>
          <div class="goal-pct">${pct}% complete</div>
        </div>
      `;
    }).join('');
  }
}

// ── Sheets ──
function openTxSheet() {
  document.getElementById('txDesc').value = '';
  document.getElementById('txAmount').value = '';
  document.getElementById('txDate').value = new Date().toISOString().split('T')[0];
  setType('expense');
  document.getElementById('txSheet').classList.add('active');
}

function openGoalSheet() {
  document.getElementById('goalName').value = '';
  document.getElementById('goalTarget').value = '';
  document.getElementById('goalCurrent').value = '';
  document.getElementById('goalSheet').classList.add('active');
}

function closeSheet(id) {
  document.getElementById(id).classList.remove('active');
}

function setType(t) {
  txType = t;
  document.getElementById('typeExpense').className = 'type-btn' + (t==='expense' ? ' active expense' : '');
  document.getElementById('typeIncome').className  = 'type-btn' + (t==='income'  ? ' active income'  : '');
  document.getElementById('catGroup').style.display = t === 'expense' ? '' : 'none';
}

function saveTx() {
  const desc   = document.getElementById('txDesc').value.trim();
  const amount = parseFloat(document.getElementById('txAmount').value);
  const date   = document.getElementById('txDate').value;
  const category = txType === 'expense' ? document.getElementById('txCat').value : 'Income';

  if (!desc || !amount || !date || amount <= 0) { alert('Please fill in all fields.'); return; }

  transactions.push({ id: Date.now().toString(), type: txType, desc, amount, date, category });
  save();
  closeSheet('txSheet');
  render();
}

function delTx(id) {
  if (!confirm('Delete this transaction?')) return;
  transactions = transactions.filter(t => t.id !== id);
  save();
  render();
}

function saveGoal() {
  const name    = document.getElementById('goalName').value.trim();
  const target  = parseFloat(document.getElementById('goalTarget').value);
  const current = parseFloat(document.getElementById('goalCurrent').value) || 0;

  if (!name || !target || target <= 0) { alert('Please enter a valid name and target.'); return; }

  goals.push({ id: Date.now().toString(), name, target, current });
  save();
  closeSheet('goalSheet');
  render();
}

function delGoal(id) {
  if (!confirm('Delete this goal?')) return;
  goals = goals.filter(g => g.id !== id);
  save();
  render();
}

// Close sheets on overlay tap
document.querySelectorAll('.sheet-overlay').forEach(el => {
  el.addEventListener('click', e => { if (e.target === el) el.classList.remove('active'); });
});

// ── PWA Install ──
let deferredPrompt = null;

window.addEventListener('beforeinstallprompt', e => {
  e.preventDefault();
  deferredPrompt = e;
  if (!localStorage.getItem('installDismissed')) {
    document.getElementById('installBanner').style.display = 'flex';
  }
});

function triggerInstall() {
  if (deferredPrompt) {
    deferredPrompt.prompt();
    deferredPrompt.userChoice.then(() => { deferredPrompt = null; dismissBanner(); });
  }
}

function dismissBanner() {
  document.getElementById('installBanner').style.display = 'none';
  localStorage.setItem('installDismissed', '1');
}

// ── Service Worker ──
if ('serviceWorker' in navigator) {
  navigator.serviceWorker.register('./service-worker.js').catch(() => {});
}

// ── Init ──
setType('expense');
render();
</script>

